auto-install-peers=true
strict-peer-dependencies=false

# store 放在项目内，宿主机和容器指向同一个物理目录
# （容器里是 /workspace/.pnpm-store），下载的包两边共用。
store-dir=.pnpm-store

# 依赖只在容器里安装（docker compose run --rm cli pnpm install）。
# 项目在宿主机和容器里的绝对路径不同（/home/... vs /workspace），
# pnpm 会把 storeDir 的绝对路径记进 node_modules/.modules.yaml，
# 一旦在宿主机上再装一次，两边对不上，pnpm 就会要求清空 node_modules。
