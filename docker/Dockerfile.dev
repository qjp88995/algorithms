# ─────────────────────────────────────────────────────────────
# 本地开发运行时：Node 22 + pnpm。源码、node_modules 和 pnpm
# store 全部落在 bind mount 的项目目录里，不使用具名卷，
# 依赖缓存天然保留在宿主机上。
#
# Husky（git 钩子）在宿主机上跑，容器里不需要 git。
# 容器内 `pnpm install` 的 prepare 步骤会提示 git 找不到，
# 这是预期的，不影响安装本身。
#
# 容器以 `node` 用户运行。UID/GID 默认 1000（node:alpine 内置
# node 用户 / 典型 Linux、WSL 宿主用户）。宿主用户不同时：
#   docker compose build --build-arg UID=$(id -u) --build-arg GID=$(id -g)
# ─────────────────────────────────────────────────────────────

FROM node:22-alpine

ARG UID=1000
ARG GID=1000

# 仅当宿主 UID/GID 与内置值不同时才重映射。
RUN if [ "$UID" != "1000" ] || [ "$GID" != "1000" ]; then \
      apk add --no-cache shadow && \
      groupmod -g "$GID" node && \
      usermod -u "$UID" -g "$GID" node && \
      apk del shadow; \
    fi

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV PNPM_STORE_DIR=/workspace/.pnpm-store

RUN corepack enable

RUN mkdir -p /pnpm /workspace && chown node:node /pnpm /workspace

WORKDIR /workspace
USER node

# 预热 corepack 缓存，避免首次 `pnpm` 调用时再下载。
RUN corepack prepare pnpm@10.33.0 --activate

CMD ["sh"]
